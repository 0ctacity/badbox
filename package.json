{
  "name": "badbox",
  "version": "0.0.1",
  "description": "Deterministic bad-pattern detection for codebases.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0ctacity/badbox.git"
  },
  "type": "module",
  "module": "./src/rules/index.ts",
  "types": "./src/rules/index.ts",
  "exports": {
    ".": "./src/rules/index.ts"
  },
  "bin": {
    "badbox": "./src/cli.ts"
  },
  "files": [
    "src",
    "rules",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "scan": "bun run src/cli.ts scan",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.45.1"
  }
}
